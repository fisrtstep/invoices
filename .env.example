MS_NAME=invoices
MS_PORT=4004
MS_DATABASE_URL=postgres://user:password@localhost:5432/invoices
# Read-only connection to the IAM database (billing details are read from its users table)
IAM_DATABASE_URL=postgres://readonly:password@localhost:5432/iam
# Key that callers (cart-ms) send in the x-internal-key header
INTERNAL_API_KEY=change-me
